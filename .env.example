# ─────────────────────────────────────────────────────────────
# Настройки Tg-skaner. Скопируйте в файл .env и заполните.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Получите на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии Telethon (создаётся автоматически при первом входе).
SESSION_NAME=tg_skaner

# Куда присылать уведомления об удалённых/изменённых сообщениях:
#   me          — в «Избранное» (Saved Messages) вашего аккаунта (по умолчанию)
#   @username   — в чат/канал по юзернейму
#   -1001234567 — по числовому id чата/канала
LOG_CHAT=me

# Сохранять ли медиа (фото/видео/документы), чтобы восстановить их после удаления.
# true — удобнее, но занимает место на диске; false — только текст.
SAVE_MEDIA=true

# Сколько дней хранить кэш сообщений и медиа (старше — автоматически удаляется).
RETENTION_DAYS=7

# true — не логировать и не показывать ваши собственные (исходящие) сообщения.
# false — фиксировать удаления с обеих сторон («для обоих»).
IGNORE_OUTGOING=false
