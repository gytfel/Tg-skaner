# ─────────────────────────────────────────────────────────────
# Настройки Tg-skaner. Скопируйте в файл .env и заполните.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Получите на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии Telethon (создаётся автоматически при первом входе).
SESSION_NAME=tg_skaner

# ── Доставка отчётов через бота (рекомендуется) ──────────────────────────────
# Токен бота от @BotFather (команда /newbot). Если задан — удалённые и изменённые
# сообщения прилетают вам в личку с этим ботом. После запуска откройте бота и
# нажмите Start. Раскомментируйте строку ниже и вставьте свой токен; если оставить
# закомментированной (пусто) — отчёты пойдут в LOG_CHAT (см. ниже).
# BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather

# Кому бот шлёт отчёты. По умолчанию — вашему же аккаунту (определяется
# автоматически). Заполните числовым id, только если нужно слать на другой аккаунт.
OWNER_ID=

# ── Запасной вариант без бота ────────────────────────────────────────────────
# Используется только если BOT_TOKEN пуст:
#   me          — в «Избранное» (Saved Messages)
#   @username   — в чат/канал по юзернейму
#   -1001234567 — по числовому id чата/канала
LOG_CHAT=me

# ── Прочее ───────────────────────────────────────────────────────────────────
# Сохранять ли медиа (фото/видео/документы), чтобы восстановить их после удаления.
SAVE_MEDIA=true

# Сколько дней хранить кэш сообщений и медиа (старше — автоматически удаляется).
RETENTION_DAYS=7

# true — не трогать ваши исходящие; false — фиксировать удаления с обеих сторон.
IGNORE_OUTGOING=false

# ── Автоэкспорт архива ───────────────────────────────────────────────────────
# Все копии сообщений пишутся в один файл export/archive.jsonl. Когда суммарный
# объём (архив + папка media/) достигает лимита, всё пакуется в zip, бот
# присылает его вам в Telegram, а локальные копии удаляются — так диск не
# забивается. true/false — включить автоэкспорт; лимит в мегабайтах.
EXPORT_ENABLED=true
EXPORT_LIMIT_MB=100
