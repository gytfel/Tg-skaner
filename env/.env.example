# ─────────────────────────────────────────────────────────────
# Настройки Tg-skaner. Скопируйте в файл .env и заполните.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Получите на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии Telethon (создаётся автоматически при первом входе).
SESSION_NAME=tg_skaner

# ── Доставка отчётов через бота (рекомендуется) ──────────────────────────────
# Токен бота от @BotFather (команда /newbot). Если задан — удалённые и изменённые
# сообщения прилетают вам в личку с этим ботом. После запуска откройте бота и
# нажмите Start. Раскомментируйте строку ниже и вставьте свой токен; если оставить
# закомментированной (пусто) — отчёты пойдут в LOG_CHAT (см. ниже).
# BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather

# Кому бот шлёт отчёты. По умолчанию — вашему же аккаунту (определяется
# автоматически). Заполните числовым id, только если нужно слать на другой аккаунт.
OWNER_ID=

# ── Запасной вариант без бота ────────────────────────────────────────────────
# Используется только если BOT_TOKEN пуст:
#   me          — в «Избранное» (Saved Messages)
#   @username   — в чат/канал по юзернейму
#   -1001234567 — по числовому id чата/канала
LOG_CHAT=me

# ── Прочее ───────────────────────────────────────────────────────────────────
# Сохранять ли медиа (фото/видео/документы), чтобы восстановить их после удаления.
SAVE_MEDIA=true

# Сколько дней хранить кэш сообщений и медиа (старше — автоматически удаляется).
RETENTION_DAYS=7

# Часовой пояс для времени в переписках, например Europe/Moscow, Europe/Kyiv,
# Asia/Almaty. Пусто — время сервера (на VPS это обычно UTC).
TIMEZONE=

# ── Защита диска ─────────────────────────────────────────────────────────────
# Не скачивать вложения больше этого размера (МБ); 0 — без ограничения.
# Большие видео — главная причина переполнения диска.
MAX_MEDIA_MB=50

# Сколько места на диске всегда оставлять свободным (МБ). Если свободно меньше,
# новые вложения не качаются (текст пишется), а накопленное выгружается раньше.
MIN_FREE_MB=1024

# false — не архивировать каналы-ленты (новостные/публичные каналы): это не
# переписки, а именно они дают гигабайты медиа. Группы и личные чаты пишутся
# всегда. true — архивировать и каналы.
ARCHIVE_CHANNELS=false

# true — не трогать ваши исходящие; false — фиксировать удаления с обеих сторон.
IGNORE_OUTGOING=false

# ── Автоэкспорт архива ───────────────────────────────────────────────────────
# Все копии сообщений пишутся в один файл export/archive.jsonl. Когда суммарный
# объём (архив + папка media/) достигает лимита, бот присылает файл переписки
# (HTML, открывается прямо в Telegram) и zip с вложениями, а локальные копии
# удаляются — так диск не забивается. true/false — включить; лимит в МБ.
EXPORT_ENABLED=true
EXPORT_LIMIT_MB=100

# ── Тихий режим ──────────────────────────────────────────────────────────────
# true  — бот ничего не пишет: удаления и правки только записываются в архив,
#         а приходит лишь файл переписки и zip с вложениями (при
#         EXPORT_LIMIT_MB). После доставки данные на сервере удаляются.
# false — дополнительно каждое удаление/правка сразу приходит сообщением.
PASSIVE_MODE=true
